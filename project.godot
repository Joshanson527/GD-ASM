; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GD-ASM"
config/description="A custom assembly IDE and compiler written in Godot"
config/version="0.2"
run/main_scene="uid://cfefud5uifb5g"
run/enable_alt_space_menu=true
run/use_game_mode=false
config/features=PackedStringArray("4.8", "GL Compatibility")
boot_splash/stretch_mode=3
boot_splash/use_filter=false
boot_splash/image="uid://d3r1yc4oimh41"
config/icon="uid://d3r1yc4oimh41"
config/macos_native_icon="res://Assets/gd-asm.icns"
config/windows_native_icon="res://Assets/gd-asm.ico"
boot_splash/minimum_display_time=500

[display]

window/energy_saving/keep_screen_on=false
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdscript-templates/plugin.cfg", "res://addons/project_statistics/plugin.cfg")

[global_group]

console="group for console node"

[gui]

common/auto_focus_strategy=1

